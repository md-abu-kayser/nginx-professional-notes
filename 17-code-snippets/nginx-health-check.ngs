default_url = "http://localhost:${ENV.get('NGINX_PORT', '80')}/"
check_url = ARGV.len() > 0 ? ARGV[0] : default_url

echo("Starting Nginx health check at $(date)")
all_ok = true

# 1. Check if Nginx process is running
F check_process() {
    try {
        output = $(ps -C nginx -o pid= 2>/dev/null).trim()
        if output.len() > 0 {
            echo("[✓] Nginx processes running (PIDs: ${output.split('\n').join(', ')})")
            return true
        } else {
            echo("[✗] No Nginx process found")
            return false
        }
    } catch(e) {
        # Fallback with pgrep
        try {
            $(pgrep nginx)
            echo("[✓] Nginx process found via pgrep")
            return true
        } catch(e) {
            echo("[✗] Failed to detect Nginx process: $e")
            return false
        }
    }
}
all_ok = check_process() and all_ok

# 2. Check port binding
F check_port() {
    port = check_url.split(":")[2]?.split("/")[0] or "80"
    try {
        # Using ss (modern) or netstat
        result = $(ss -tlnp 2>/dev/null | grep ":$port ").trim()
        if result.len() > 0 {
            echo("[✓] Nginx listening on port $port")
            return true
        } else {
            echo("[✗] No listener on port $port")
            return false
        }
    } catch(e) {
        try {
            $(netstat -tlnp | grep ":$port " 2>/dev/null)
            echo("[✓] Nginx listening on port $port (netstat)")
            return true
        } catch(e) {
            echo("[✗] Port check failed: $e")
            return false
        }
    }
}
all_ok = check_port() and all_ok

# 3. HTTP response check
F check_http(url) {
    try {
        http_code = $(curl -s -o /dev/null -w "%{http_code}" "$url" --max-time 5).trim()
        if http_code.code() >= 200 and http_code.code() <= 499 {
            echo("[✓] HTTP response from $url : $http_code")
            return true
        } else {
            echo("[✗] Unexpected HTTP code: $http_code")
            return false
        }
    } catch(e) {
        echo("[✗] HTTP check failed: $e")
        return false
    }
}
all_ok = check_http(check_url) and all_ok

# 4. Optional system resource usage (not failing the check)
try {
    # CPU load average
    load = $(cat /proc/loadavg 2>/dev/null | awk '{print $1,$2,$3}').trim()
    if load.len() > 0 {
        echo("[i] System load: $load")
    }

    # Memory usage
    mem = $(free -h 2>/dev/null | grep Mem | awk '{print $3 "/" $2}').trim()
    if mem.len() > 0 {
        echo("[i] Memory used: $mem")
    }
} catch(e) {
    echo("[i] Could not read system resources")
}

# 5. Summary
if all_ok {
    echo("\n✓ Nginx is healthy")
    exit(0)
} else {
    echo("\n✗ Nginx health check failed!")
    exit(1)
}